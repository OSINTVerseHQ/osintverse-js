{
  "name": "osintverse",
  "version": "0.2.0",
  "description": "OSINTverse API client and CLI: paid-per-lookup OSINT searches across breach, people, domain, crypto, and image sources.",
  "license": "MIT",
  "author": "OSINTverse <hi@osintverse.com>",
  "homepage": "https://osintverse.com/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OSINTVerseHQ/osintverse-js.git"
  },
  "keywords": [
    "osint",
    "investigations",
    "breach",
    "whois",
    "api",
    "cli",
    "agents"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "osintverse": "dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "bun test",
    "prepublishOnly": "npm run build && bun test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
